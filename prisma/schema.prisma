generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tiers {
  id              String   @id @default(cuid())
  code            String   @unique
  type            String
  raisonSociale   String
  adresse         String?
  adresse2        String?
  codePostal      String?
  ville           String?
  pays            String?
  telephone       String?
  email           String?
  ice             String?
  rc              String?
  rcLieu          String?
  if              String?
  tp              String?
  cnss            String?
  infoLibre       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facturesClients          FactureClient[]
  facturesFournisseurs     FactureFournisseur[]
  bonsLivraison            BonLivraison[]
  avoirsClients            AvoirClient[]
}

model Article {
  id            String   @id @default(cuid())
  code          String   @unique
  designation   String
  prixUnitaire  Float    @default(0)
  unite         String   @default("pièce")
  tauxTVA       Float    @default(20)
  infoLibre     String?
  actif         Boolean  @default(true)
  conditionnement Float  @default(0) // V2.93: Qté par emballage (0 = pas d'étiquettes)
  // Nouveaux champs V2.63
  diametreFil   Float?   // Diamètre de fil en mm
  poidsGr       Float?   // Poids en grammes
  typeAcier     String?  // Type d'acier
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lignesFactureClient    LigneFactureClient[]
  lignesBonLivraison     LigneBonLivraison[]
  lignesAvoirClient      LigneAvoirClient[]
}

model FactureClient {
  id              String   @id @default(cuid())
  numero          String   @unique
  dateFacture     DateTime
  clientId        String
  bonCommande     String?  // Numéro de bon de commande client
  numeroBL        String?  // Numéro de BL (auto-rempli si converti depuis BL)
  dateEcheance    DateTime
  statut          String   @default("BROUILLON")
  notes           String?
  notesLivraison  String?
  infoLibre       String?
  totalHT         Float    @default(0)
  totalTVA        Float    @default(0)
  totalTTC        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Tiers              @relation(fields: [clientId], references: [id])
  lignes          LigneFactureClient[]
  reglements      ReglementClient[]
  bonsLivraison   BonLivraison[]     // BL convertis en cette facture
  avoirs          AvoirClient[]      // Avoirs créés depuis cette facture

  @@index([clientId])
  @@index([statut])
}

model LigneFactureClient {
  id            String   @id @default(cuid())
  factureId     String
  articleId     String?
  designation   String
  quantite      Float    @default(0)
  prixUnitaire  Float    @default(0)
  tauxTVA       Float    @default(20)
  totalHT       Float    @default(0)

  facture       FactureClient @relation(fields: [factureId], references: [id], onDelete: Cascade)
  article       Article?      @relation(fields: [articleId], references: [id])

  @@index([factureId])
}

model ReglementClient {
  id              String   @id @default(cuid())
  numero          String   @unique
  factureId       String
  dateReglement   DateTime
  montant         Float    @default(0)
  modePaiement    String   @default("VIREMENT")
  reference       String?
  infoLibre       String?
  notes           String?
  statut          String   @default("ENREGISTRE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facture         FactureClient @relation(fields: [factureId], references: [id])

  @@index([factureId])
  @@index([statut])
}

model AvoirClient {
  id              String   @id @default(cuid())
  numero          String   @unique
  dateAvoir       DateTime
  clientId        String
  factureId       String?  // Facture d'origine (optionnel)
  motif           String?
  statut          String   @default("BROUILLON")
  notes           String?
  infoLibre       String?
  totalHT         Float    @default(0)
  totalTVA        Float    @default(0)
  totalTTC        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Tiers              @relation(fields: [clientId], references: [id])
  facture         FactureClient?     @relation(fields: [factureId], references: [id])
  lignes          LigneAvoirClient[]

  @@index([clientId])
  @@index([statut])
  @@index([factureId])
}

model LigneAvoirClient {
  id            String   @id @default(cuid())
  avoirId       String
  articleId     String?
  designation   String
  quantite      Float    @default(0)
  prixUnitaire  Float    @default(0)
  tauxTVA       Float    @default(20)
  totalHT       Float    @default(0)

  avoir         AvoirClient @relation(fields: [avoirId], references: [id], onDelete: Cascade)
  article       Article?    @relation(fields: [articleId], references: [id])

  @@index([avoirId])
}

model FactureFournisseur {
  id              String   @id @default(cuid())
  numeroFacture   String
  fournisseurId   String
  dateFacture     DateTime
  dateEcheance    DateTime
  montantHT       Float    @default(0)
  montantTVA      Float    @default(0)
  montantTTC      Float    @default(0)
  statut          String   @default("ENREGISTREE")
  infoLibre       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fournisseur     Tiers                 @relation(fields: [fournisseurId], references: [id])
  reglements      ReglementFournisseur[]

  @@index([fournisseurId])
  @@index([statut])
}

model ReglementFournisseur {
  id              String   @id @default(cuid())
  factureId       String
  dateReglement   DateTime
  montant         Float    @default(0)
  modePaiement    String   @default("VIREMENT")
  reference       String?
  infoLibre       String?
  notes           String?
  statut          String   @default("ENREGISTRE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facture         FactureFournisseur @relation(fields: [factureId], references: [id])

  @@index([factureId])
  @@index([statut])
}

model BonLivraison {
  id              String   @id @default(cuid())
  numero          String   @unique
  dateBL          DateTime
  clientId        String
  bonCommande     String?  // Numéro de bon de commande client
  statut          String   @default("BROUILLON")
  infoLibre       String?
  notesLivraison  String?
  totalHT         Float    @default(0)
  factureId       String?  // ID de la facture si le BL a été converti
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Tiers               @relation(fields: [clientId], references: [id])
  lignes          LigneBonLivraison[]
  facture         FactureClient?      @relation(fields: [factureId], references: [id])

  @@index([clientId])
  @@index([statut])
  @@index([factureId])
}

model LigneBonLivraison {
  id              String   @id @default(cuid())
  bonLivraisonId  String
  articleId       String?
  designation     String
  quantite        Float    @default(0)
  prixUnitaire    Float    @default(0)
  totalHT         Float    @default(0)

  bonLivraison    BonLivraison @relation(fields: [bonLivraisonId], references: [id], onDelete: Cascade)
  article         Article?     @relation(fields: [articleId], references: [id])

  @@index([bonLivraisonId])
}

// V3.33 - Bons de commande (suivi commande -> BL -> facture)
model BonCommande {
  id              String   @id @default(cuid())
  numero          String   @unique
  dateCommande    DateTime
  dateReception   DateTime?
  clientId        String
  referenceClient String?  // N° de bon de commande du client
  statut          String   @default("EN_COURS")  // EN_COURS, FACTUREE, ANNULEE
  infoLibre       String?
  notes           String?
  totalHT         Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lignes          LigneBonCommande[]
  liens           CommandeBonLivraison[]

  @@index([clientId])
  @@index([statut])
}

model LigneBonCommande {
  id            String   @id @default(cuid())
  commandeId    String
  articleId     String?
  designation   String
  quantite      Float    @default(0)
  prixUnitaire  Float    @default(0)
  totalHT       Float    @default(0)

  commande      BonCommande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([commandeId])
}

// Lien BL <-> commande (table d'attelage pour ne pas modifier la table BonLivraison en prod)
model CommandeBonLivraison {
  id         String   @id @default(cuid())
  commandeId String
  blId       String
  createdAt  DateTime @default(now())

  commande   BonCommande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@unique([commandeId, blId])
  @@index([blId])
}

model ExpeditionArchive {
  id              String   @id @default(cuid())
  blId            String?  @unique
  client          String
  blNumero        String
  dateExpedition  DateTime
  qteTotalBL      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lignes          ExpeditionArchiveLigne[]
  contenants      ExpeditionContenant[]

  @@index([blNumero])
  @@index([dateExpedition])
}

model ExpeditionArchiveLigne {
  id              String   @id @default(cuid())
  expeditionId    String
  client          String
  refProduit      String
  designation     String
  blNumero        String
  dateExpedition  DateTime
  qteEtiquette    Float    @default(0)
  numeroContenant String
  numeroLot       String?
  qteTotalBL      Float    @default(0)
  createdAt       DateTime @default(now())

  expedition      ExpeditionArchive @relation(fields: [expeditionId], references: [id], onDelete: Cascade)

  @@index([expeditionId])
  @@index([refProduit])
  @@index([numeroContenant])
  @@index([numeroLot])
}

model ExpeditionContenant {
  id              String   @id @default(cuid())
  expeditionId    String
  reference       String
  numero          Int
  qrToken         String   @unique
  qteEtiquette    Float    @default(0)
  numeroLot       String?
  createdAt       DateTime @default(now())

  expedition      ExpeditionArchive @relation(fields: [expeditionId], references: [id], onDelete: Cascade)

  @@unique([reference, numero])
  @@index([expeditionId])
}

model DocumentScan {
  id          String   @id @default(cuid())
  typeDoc     String   // FACTURE_CLIENT, BON_LIVRAISON, AVOIR_CLIENT, FACTURE_FOURNISSEUR
  numeroDoc   String   // ex: FC00042, BL00010
  nature      String   @default("AR_CLIENT") // AR_CLIENT, ORIGINAL, AUTRE
  nomFichier  String
  storagePath String
  mimeType    String
  taille      Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([typeDoc, numeroDoc])
  @@index([nature])
}

model Parametres {
  id                    String   @id @default(cuid())
  nomEntreprise         String   @default("")
  adresseEntreprise     String?
  villeEntreprise       String?
  telephoneEntreprise   String?
  emailEntreprise       String?
  ice                   String?
  rc                    String?
  rcLieu                String?
  if                    String?
  tp                    String?
  cnss                  String?
  infoLibre             String?
  tvaDefaut             Float    @default(20)
  prefixeFacture        String?
  numeroFactureDepart   Int?
  prefixeBL             String?
  numeroBLDepart        Int?
  prefixeAvoir          String?
  numeroAvoirDepart     Int?
  letterheadImage       String?  // Base64 image du papier à en-tête
  printLayout           String?  // JSON string - Configuration des positions des éléments
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============ V2.98: TEMPLATES D'ÉTIQUETTES ============

model LabelTemplate {
  id              String   @id @default(cuid())
  name            String   // Nom du template (ex: "Étiquette colis", "Étiquette article")
  width           Float    @default(100)  // Largeur en mm
  height          Float    @default(60)   // Hauteur en mm
  backgroundImage String?  // Image de fond en base64 (JPG/PNG)
  fields          String   @default("[]") // JSON: tableau de champs dynamiques
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ AUTHENTICATION - NextAuth.js ============

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String    // Hashed password
  role          String    @default("USER")  // ADMIN, USER
  permissions   String?   // JSON string with permissions
  actif         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
